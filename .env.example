# Email signup adapter. Leave every key blank in local dev: the form still
# succeeds and the address is written to the server log.
#
# Buttondown. When this is set, signups POST to
# https://api.buttondown.com/v1/subscribers with Authorization: Token <key>.
# EMAIL_PROVIDER and EMAIL_API_KEY take precedence when both are set.
BUTTONDOWN_API_KEY=

# Or choose a provider explicitly.
# EMAIL_PROVIDER: buttondown | beehiiv | resend
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Beehiiv publication id (required when EMAIL_PROVIDER=beehiiv)
EMAIL_PUBLICATION_ID=

# Resend audience id (required when EMAIL_PROVIDER=resend)
EMAIL_AUDIENCE_ID=

# Story-tip email via SMTP (nodemailer). All four must be set or the submit
# form only logs the tip (and still POSTs SUBMISSION_WEBHOOK_URL when that
# is set). The form still shows success. The build does not need these.
# Gmail or Google Workspace, with an app password for the cheers mailbox:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=cheers@tazzora.com
#   SMTP_PASS=the app password
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional. POST each reader tip as JSON to this URL (Slack incoming
# webhook, Zapier, a CMS, or an editor inbox bridge). Still used when the
# SMTP variables above are missing.
SUBMISSION_WEBHOOK_URL=

# Search Console HTML-tag method. Paste only the content value, then redeploy.
# The tag is emitted on every page. Leave blank until the property is created.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster HTML-tag method (meta name msvalidate.01). Same idea.
BING_SITE_VERIFICATION=

# Good Neighbor shared votes. Leave GOOD_NEIGHBOR_VOTES unset and the ballot
# uses Cheer your favorite in the browser. No account is required for that.
# file: persistent disk only (not Vercel). Votes go in data/good-neighbor-votes.json.
# upstash: free Redis REST. Also set the URL and token. The URL must be https.
# GOOD_NEIGHBOR_IP_SALT is a long random string (16+ characters) used only to hash
# a browser id and, for rate limits, the network address. Raw IPs are not stored.
GOOD_NEIGHBOR_VOTES=
GOOD_NEIGHBOR_IP_SALT=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
