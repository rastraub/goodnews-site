# Email signup adapter. Leave both blank in local dev: the form still
# succeeds and the address is written to the server log.
#
# EMAIL_PROVIDER: buttondown | beehiiv | resend
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Beehiiv publication id (required when EMAIL_PROVIDER=beehiiv)
EMAIL_PUBLICATION_ID=

# Resend audience id (required when EMAIL_PROVIDER=resend)
EMAIL_AUDIENCE_ID=

# Optional. POST each reader tip as JSON to this URL (Slack incoming
# webhook, Zapier, a CMS, or an editor inbox bridge).
SUBMISSION_WEBHOOK_URL=
